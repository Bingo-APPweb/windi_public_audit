#!/bin/bash
# =============================================================================
# WINDI Pre-Commit Hook — Witness Enforcement
# =============================================================================
# HOOK-AC1: Blocks policy/runtime docs without Testemunhas block
# HOOK-AC2: Self-test with §PG historical commit as negative control
# HOOK-AC3: Lives in scripts/hooks/, installed via symlink or core.hooksPath
# HOOK-AC4: Scope restricted to POLICY/DOUTRINA/spec patterns
#
# This hook checks FORM, not TRUTH.
# It forces the checklist — it doesn't verify the content.
# The truth remains human work at the Gate.
# The hook only guarantees the question was posed.
#
# A hook that gives false positives teaches --no-verify.
# A hook bypassed by routine is REPRESENTADO≠OPERANTE in executable form.
#
# Reference: W-INCIDENTE-FRONTEIRA-002
# Born: 2026-08-06 · Kempten, Bavaria
# =============================================================================

# Note: set -e disabled to allow self-test to run completely
# set -e

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

# =============================================================================
# HOOK-AC4: Scope — Only these patterns on day 1
# =============================================================================
POLICY_PATTERNS=(
    "*POLICY*"
    "*DOUTRINA*"
    "*-spec*"
    "W-*-001*"
    "*CANONICAL*"
)

# =============================================================================
# HOOK-AC1: Check for Testemunhas block or AC references
# =============================================================================
check_witness_block() {
    local file="$1"
    local staged_content="$2"

    # Check if file contains policy/runtime assertions
    # Patterns that indicate runtime behavior promises:
    local has_runtime_assertion=false

    if echo "$staged_content" | grep -qiE '(é avisado|will be notified|wird benachrichtigt)'; then
        has_runtime_assertion=true
    fi
    if echo "$staged_content" | grep -qiE '(podem expirar|can expire|können ablaufen)'; then
        has_runtime_assertion=true
    fi
    if echo "$staged_content" | grep -qiE '(Art\. [0-9]+|GDPR|DSGVO)'; then
        has_runtime_assertion=true
    fi
    if echo "$staged_content" | grep -qiE '(Consentimento|consent|Einwilligung)'; then
        has_runtime_assertion=true
    fi
    if echo "$staged_content" | grep -qiE '(retenção|retention|Aufbewahrung)'; then
        has_runtime_assertion=true
    fi

    if [ "$has_runtime_assertion" = false ]; then
        # No runtime assertions detected, pass
        return 0
    fi

    # Runtime assertions exist — check for witnesses
    local has_witnesses=false

    # Check for Testemunhas section
    if echo "$staged_content" | grep -qE '^## Testemunhas'; then
        has_witnesses=true
    fi

    # Check for AC references (AC-A1, AC-B2, etc.)
    if echo "$staged_content" | grep -qE 'AC-[A-Z][0-9]'; then
        has_witnesses=true
    fi

    # Check for explicit "Testemunha:" field
    if echo "$staged_content" | grep -qE '\*\*Testemunha\*\*:|Testemunha:'; then
        has_witnesses=true
    fi

    if [ "$has_witnesses" = false ]; then
        return 1  # Fail: runtime assertions without witnesses
    fi

    return 0  # Pass
}

# =============================================================================
# Main hook logic
# =============================================================================
run_hook() {
    local failed=false
    local failed_files=()

    # Get staged .md files
    local staged_files
    staged_files=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.md$' || true)

    if [ -z "$staged_files" ]; then
        # No markdown files staged
        return 0
    fi

    for file in $staged_files; do
        # HOOK-AC4: Check if file matches policy patterns
        local matches_pattern=false
        for pattern in "${POLICY_PATTERNS[@]}"; do
            if [[ "$file" == $pattern ]]; then
                matches_pattern=true
                break
            fi
        done

        # Also check if file is in docs/ directory and looks like policy
        if [[ "$file" == docs/* ]] && [[ "$file" =~ (POLICY|DOUTRINA|CANONICAL|spec) ]]; then
            matches_pattern=true
        fi

        if [ "$matches_pattern" = false ]; then
            continue
        fi

        # Get staged content of the file
        local staged_content
        staged_content=$(git show ":$file" 2>/dev/null || cat "$file" 2>/dev/null || echo "")

        if [ -z "$staged_content" ]; then
            continue
        fi

        # Check for witness block
        if ! check_witness_block "$file" "$staged_content"; then
            failed=true
            failed_files+=("$file")
        fi
    done

    if [ "$failed" = true ]; then
        echo ""
        echo -e "${RED}═══════════════════════════════════════════════════════════════${NC}"
        echo -e "${RED}  HOOK BLOCKED — I14: Explicit Failure Principle${NC}"
        echo -e "${RED}═══════════════════════════════════════════════════════════════${NC}"
        echo ""
        echo -e "${YELLOW}Policy file(s) with runtime assertions but NO witnesses:${NC}"
        echo ""
        for f in "${failed_files[@]}"; do
            echo -e "  ${RED}✗${NC} $f"
        done
        echo ""
        echo -e "${YELLOW}What's missing:${NC}"
        echo "  1. A '## Testemunhas' section with affirmation→AC→state table, OR"
        echo "  2. AC-* references (e.g., AC-A1, AC-B2) for each runtime assertion"
        echo ""
        echo -e "${YELLOW}Why this matters:${NC}"
        echo "  Runtime assertions without witnesses are DOCUMENTADO≠IMPLEMENTADO."
        echo "  The hook checks form, not truth — but the question must be posed."
        echo "  See: W-INCIDENTE-FRONTEIRA-002"
        echo ""
        echo -e "${YELLOW}To bypass (leaves audit trail):${NC}"
        echo "  git commit --no-verify"
        echo ""
        echo -e "${RED}═══════════════════════════════════════════════════════════════${NC}"
        return 1
    fi

    return 0
}

# =============================================================================
# HOOK-AC2: Self-test with §PG as negative control
# =============================================================================
selftest() {
    echo "WINDI Pre-Commit Hook — Self-Test"
    echo "=================================="
    echo ""

    local passed=0
    local failed=0

    # Test 1: §PG content WITHOUT witnesses (must FAIL)
    echo "Test 1: §PG content without witnesses (expect BLOCK)..."

    local pg_content='## §PG — Playground Store (ASSERTED_AUTHORSHIP)

*Adenda 2026-08-05 · W-PLAYGROUND-W7-MINIMAL-001 · Gate D*

### Propriedades conhecidas

1. **Oráculo de existência**: O Playground Store permite consulta por hash.

2. **declared_name**: Campo voluntário. O valor fornecido pelo utilizador
   é exibido publicamente na página de verificação. O utilizador é avisado
   antes da submissão: *"Este nome será público e associado ao hash."*

3. **Retenção**: Fracções não-reclamadas (sem DID associado) podem expirar
   após 12 meses. A descartabilidade honesta fortalece a posição GDPR.

### Base legal (GDPR)

- **Art. 6(1)(a)**: Consentimento explícito no momento da submissão
- **Art. 13**: Informação prévia sobre publicação e retenção
- **Art. 17**: Direito ao apagamento limitado a fracções não-ancoradas'

    if check_witness_block "docs/TEST-POLICY.md" "$pg_content"; then
        echo -e "  ${RED}✗ FAIL${NC} — Hook should have blocked this (no witnesses)"
        ((failed++))
    else
        echo -e "  ${GREEN}✓ PASS${NC} — Hook correctly blocked content without witnesses"
        ((passed++))
    fi

    # Test 2: §PG content WITH witnesses (must PASS)
    echo "Test 2: §PG content with AC references (expect PASS)..."

    local pg_with_witnesses='## §PG — Playground Store (ASSERTED_AUTHORSHIP)

O utilizador é avisado antes da submissão. (AC-A1)

### Base legal (GDPR)

- **Art. 6(1)(a)**: Consentimento explícito (AC-A2)

## Testemunhas

| Afirmação | AC | Estado |
|-----------|-----|--------|
| Aviso prévio | AC-A1 | Pendente |
| Consentimento | AC-A2 | Pendente |'

    if check_witness_block "docs/TEST-POLICY.md" "$pg_with_witnesses"; then
        echo -e "  ${GREEN}✓ PASS${NC} — Hook correctly allowed content with witnesses"
        ((passed++))
    else
        echo -e "  ${RED}✗ FAIL${NC} — Hook should have allowed this (has witnesses)"
        ((failed++))
    fi

    # Test 3: Non-policy content (must PASS regardless)
    echo "Test 3: Generic README content (expect PASS)..."

    local readme_content='# My Project

This is a README file with no policy content.

## Installation

Run npm install.'

    if check_witness_block "README.md" "$readme_content"; then
        echo -e "  ${GREEN}✓ PASS${NC} — Hook correctly allowed non-policy content"
        ((passed++))
    else
        echo -e "  ${RED}✗ FAIL${NC} — Hook should not block non-policy content"
        ((failed++))
    fi

    # Test 4: Content with GDPR but with Testemunha field (must PASS)
    echo "Test 4: GDPR reference with explicit Testemunha field (expect PASS)..."

    local gdpr_with_witness='## Política de Retenção

Os dados são retidos conforme Art. 17 GDPR.

**Testemunha:** AC-C1 implementa purge job.'

    if check_witness_block "docs/POLICY-X.md" "$gdpr_with_witness"; then
        echo -e "  ${GREEN}✓ PASS${NC} — Hook correctly allowed GDPR content with witness"
        ((passed++))
    else
        echo -e "  ${RED}✗ FAIL${NC} — Hook should have allowed this (has Testemunha field)"
        ((failed++))
    fi

    echo ""
    echo "=================================="
    echo "Results: $passed passed, $failed failed"
    echo ""

    if [ "$failed" -gt 0 ]; then
        echo -e "${RED}Self-test FAILED — hook is miscalibrated${NC}"
        return 1
    else
        echo -e "${GREEN}Self-test PASSED — hook is calibrated correctly${NC}"
        echo ""
        echo "The hook correctly:"
        echo "  - Blocks §PG-style content without witnesses (negative control)"
        echo "  - Allows content with ## Testemunhas or AC-* references"
        echo "  - Ignores non-policy content"
        return 0
    fi
}

# =============================================================================
# Entry point
# =============================================================================
case "${1:-}" in
    --selftest)
        selftest
        exit $?
        ;;
    --help)
        echo "WINDI Pre-Commit Hook — Witness Enforcement"
        echo ""
        echo "Usage:"
        echo "  (as hook)     Runs automatically on git commit"
        echo "  --selftest    Run self-test with negative control"
        echo "  --help        Show this help"
        echo ""
        echo "Installation:"
        echo "  ln -sf ../../scripts/hooks/pre-commit .git/hooks/pre-commit"
        echo "  OR"
        echo "  git config core.hooksPath scripts/hooks"
        echo ""
        echo "Scope (HOOK-AC4):"
        echo "  Only checks: *POLICY*, *DOUTRINA*, *-spec*, W-*-001*, *CANONICAL*"
        echo ""
        echo "Reference: W-INCIDENTE-FRONTEIRA-002"
        exit 0
        ;;
    *)
        run_hook
        exit $?
        ;;
esac
