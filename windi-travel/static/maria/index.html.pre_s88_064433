// §87 — OSRM Routing Soberano (Zero dependências externas)
async function windiRoute(fromLng, fromLat, toLng, toLat) {
  const url = `http://router.project-osrm.org/route/v1/driving/${fromLng},${fromLat};${toLng},${toLat}?overview=full&geometries=geojson`;
  const res = await fetch(url);
  const data = await res.json();
  if (data.code !== 'Ok') return null;
  return data.routes[0].geometry.coordinates.map(c => [c[1], c[0]]);
}

function drawRoute(map, userLat, userLng, destLat, destLng) {
  windiRoute(userLng, userLat, destLng, destLat).then(points => {
    if (!points) return console.error('[§87] OSRM falhou');
    if (window._windiRoute) window._windiRoute.remove();
    window._windiRoute = L.polyline(points, {
      color: '#C8860A', weight: 4, opacity: 0.85
    }).addTo(map);
    map.fitBounds(window._windiRoute.getBounds(), { padding: [40, 40] });
  });
}

function SuperCarta({ locations, userLat, userLng, lang }) {
  const mapRef = useRef(null);
  const mapInstance = useRef(null);
  const markersRef = useRef([]);

  useEffect(() => {
    if (!locations || locations.length === 0 || !mapRef.current) return;
    if (typeof L === "undefined") return; // Leaflet not loaded

    // Clean previous map
    if (mapInstance.current) {
      mapInstance.current.remove();
      mapInstance.current = null;
    }
    markersRef.current = [];

    // Calculate center (average of locations or user position)
    let centerLat = userLat || 47.72;
    let centerLng = userLng || 10.31;
    if (locations.length > 0) {
      const validLocs = locations.filter(l => l.lat && l.lng);
      if (validLocs.length > 0) {
        centerLat = validLocs.reduce((s, l) => s + l.lat, 0) / validLocs.length;
        centerLng = validLocs.reduce((s, l) => s + l.lng, 0) / validLocs.length;
      }
    }

    // Create map
    const map = L.map(mapRef.current, {
      center: [centerLat, centerLng],
      zoom: 14,
      zoomControl: false,
      attributionControl: false
    });
    mapInstance.current = map;

    // OpenStreetMap tiles (FREE + Sovereign!)
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19
    }).addTo(map);

    // Add zoom control to bottom-right
    L.control.zoom({ position: 'bottomright' }).addTo(map);

    // Create custom icon function
    const createIcon = (type) => {
      const emoji = PIN_ICONS[type] || PIN_ICONS.default;
      return L.divIcon({
        html: `<div style="font-size:24px;text-shadow:0 2px 4px rgba(0,0,0,0.3);filter:drop-shadow(0 1px 2px rgba(0,0,0,0.2));">${emoji}</div>`,
        className: 'super-carta-pin',
        iconSize: [32, 32],
        iconAnchor: [16, 32],
        popupAnchor: [0, -32]
      });
    };

    // Add user position marker (if available)
    if (userLat && userLng) {
      const userMarker = L.marker([userLat, userLng], {
        icon: L.divIcon({
          html: '<div style="width:14px;height:14px;background:#4A7C9E;border:3px solid white;border-radius:50%;box-shadow:0 2px 8px rgba(0,0,0,0.3);"></div>',
          className: 'user-marker',
          iconSize: [14, 14],
          iconAnchor: [7, 7]
        })
      }).addTo(map);
      userMarker.bindPopup(lang === "PT" ? "Você está aqui" : lang === "DE" ? "Du bist hier" : "You are here");
    }

    // Add location markers
    locations.forEach((loc, idx) => {
      if (!loc.lat || !loc.lng) return;
      const marker = L.marker([loc.lat, loc.lng], {
        icon: createIcon(loc.type)
      }).addTo(map);

      // Popup with place info
      const ratingStr = loc.rating ? `★ ${loc.rating}` : "";
      const openStr = loc.open_now === true ? "✓ Aberto" : loc.open_now === false ? "✗ Fechado" : "";
      // §87 — Store map reference for routing
      window._windiMap = map;
      window._windiUser = { lat: userLat, lng: userLng };

      marker.bindPopup(`
        <div style="font-family:'Bricolage Grotesque',sans-serif;min-width:140px;">
          <strong style="font-size:13px;">${loc.name}</strong>
          ${ratingStr ? `<div style="color:#C9A84C;font-size:11px;">${ratingStr}</div>` : ""}
          ${loc.address ? `<div style="font-size:10px;color:#666;margin-top:4px;">${loc.address}</div>` : ""}
          ${openStr ? `<div style="font-size:10px;margin-top:3px;">${openStr}</div>` : ""}
          ${userLat && userLng ? `<button onclick="drawRoute(window._windiMap, ${userLat}, ${userLng}, ${loc.lat}, ${loc.lng})" style="margin-top:8px;padding:4px 10px;background:#C8860A;color:white;border:none;border-radius:4px;font-size:11px;cursor:pointer;">🗺️ Rota</button>` : ""}
        </div>
      `);
      markersRef.current.push(marker);
    });

    // Fit bounds to show all markers
    if (locations.length > 1) {
      const validLocs = locations.filter(l => l.lat && l.lng);
      if (validLocs.length > 1) {
        const bounds = L.latLngBounds(validLocs.map(l => [l.lat, l.lng]));
        if (userLat && userLng) bounds.extend([userLat, userLng]);
        map.fitBounds(bounds, { padding: [30, 30] });
      }
    }

    // Cleanup on unmount
    return () => {
      if (mapInstance.current) {
        mapInstance.current.remove();
        mapInstance.current = null;
      }
    };
  }, [locations, userLat, userLng, lang]);

  if (!locations || locations.length === 0) return null;

  return (
    <div style={{ marginBottom: 14 }}>
      <div style={{ fontSize: 10, fontFamily: "'JetBrains Mono',monospace", color: P.cinza,
        marginBottom: 7, letterSpacing: "0.5px", display: "flex", alignItems: "center", gap: 6 }}>
        <span>🗺️</span>
        <span>{lang === "PT" ? "SUPER CARTA" : lang === "DE" ? "ÜBERSICHTSKARTE" : "OVERVIEW MAP"}</span>
        <span style={{ color: P.verde }}>· {locations.length} {lang === "PT" ? "local" : lang === "DE" ? "Ort" : "place"}{locations.length > 1 ? (lang === "PT" ? "is" : lang === "DE" ? "e" : "s") : ""}</span>
      </div>
      <div
        ref={mapRef}
        style={{
          width: "100%",
          height: 240,
          borderRadius: 12,
          border: `1px solid rgba(139,94,60,0.2)`,
          overflow: "hidden",
          boxShadow: "0 4px 12px rgba(0,0,0,0.08)"
        }}
      />
      <div style={{ fontSize: 9, fontFamily: "'JetBrains Mono',monospace", color: P.cinza,
        marginTop: 6, textAlign: "right", opacity: 0.7 }}>
        © OpenStreetMap · Leaflet
      </div>
    </div>
  );
}

function MicButton({onResult,onListening,lang,disabled}){
  const[active,setActive]=useState(false);
  const recRef=useRef(null);
  const SR=window.SpeechRecognition||window.webkitSpeechRecognition;
  const toggle=()=>{
    if(disabled)return;
    if(active){recRef.current&&recRef.current.stop();setActive(false);return;}
    if(!SR)return;
    const rec=new SR();
    rec.lang=lang==="DE"?"de-DE":lang==="EN"?"en-GB":"pt-PT";
    rec.interimResults=false;
    rec.onstart=()=>{setActive(true);onListening&&onListening();};
    rec.onresult=e=>{setActive(false);onResult&&onResult(e.results[0][0].transcript);};
    rec.onerror=()=>setActive(false);
    rec.onend=()=>setActive(false);
    recRef.current=rec;rec.start();
  };
  return(
    <div style={{display:"flex",flexDirection:"column",alignItems:"center",gap:8}}>
      <button onClick={toggle} disabled={disabled} style={{
        width:76,height:76,borderRadius:"50%",
        background:active?`radial-gradient(circle,${P.vermelho}cc,${P.terra}99)`:`radial-gradient(circle,${P.terra}33,transparent)`,
        border:`3px solid ${active?P.vermelho:P.terra}`,
        display:"flex",alignItems:"center",justifyContent:"center",fontSize:28,
        cursor:disabled?"not-allowed":"pointer",
        animation:active?"pulse 1s infinite":"none",transition:"all 0.3s",
        opacity:disabled?0.4:1,boxShadow:active?`0 0 24px ${P.vermelho}66`:"none"}}>
        {active?"⏹":"🎙️"}
      </button>
      {!SR&&<div style={{fontSize:10,color:P.cinza,textAlign:"center",maxWidth:180}}>Browser sem suporte a voz</div>}
    </div>
  );
}

function App(){
  const[lang,setLang]=useState("PT");
  const t=I18N[lang];
  const[mode,setMode]=useState("idle");
  const[result,setResult]=useState(null);
  const[activeStage,setActiveStage]=useState(null);
  const[doneSt,setDoneSt]=useState([]);
  const[sealed,setSealed]=useState(false);
  const[textIn,setTextIn]=useState("");
  const[transcript,setTranscript]=useState("");
  const[showIntent,setShowIntent]=useState(false);
  const[apiSource,setApiSource]=useState(null);
  const[backendOK,setBackendOK]=useState(null);
  const[greeting,setGreeting]=useState(null);
  const[weather,setWeather]=useState(null);
  const[userGPS,setUserGPS]=useState({lat:null,lng:null});
  const timers=useRef([]);

  useEffect(()=>{
    // Health check
    fetch(MARIA_HEALTH,{signal:AbortSignal.timeout(3000)})
      .then(r=>setBackendOK(r.ok))
      .catch(()=>setBackendOK(false));
    // §65 — Personalized greeting on load + save GPS for SuperCarta
    getGPS().then(({lat,lng})=>{
      if(lat&&lng)setUserGPS({lat,lng});
    });
    if(WALLET_ID){
      getGPS().then(({lat,lng})=>{
        if(lat&&lng)setUserGPS({lat,lng});
        fetch(MARIA_API,{
          method:"POST",headers:{"Content-Type":"application/json"},
          body:JSON.stringify({intent:{type:"greeting"},lang,lat,lng,wallet_id:WALLET_ID}),
          signal:AbortSignal.timeout(API_TIMEOUT)
        })
        .then(r=>r.json())
        .then(d=>{
          if(d.context&&d.context.greeting)setGreeting(d.context.greeting);
          if(d.context&&d.context.weather)setWeather(d.context.weather);
        })
        .catch(()=>{});
      });
    }
  },[]);

  const clearT=()=>{timers.current.forEach(clearTimeout);timers.current=[];};

  const runPipeline=useCallback(async(intent,inputText,fallbackSc)=>{
    clearT();
    setTranscript(inputText);setMode("processing");
    setDoneSt([]);setSealed(false);setShowIntent(false);setResult(null);
    const ids=STAGES.map(s=>s.id);
    ids.forEach((id,i)=>{
      const t0=setTimeout(()=>{
        setActiveStage(id);
        setDoneSt(prev=>[...prev,ids[i-1]].filter(Boolean));
      },i*480);
      timers.current.push(t0);
    });
    const{source,data}=await callMariaAPI(intent,lang,fallbackSc,inputText);
    setApiSource(source);
    const wait=ids.length*480+300;
    const t1=setTimeout(()=>{
      setDoneSt(ids.slice(0,-1));setActiveStage(null);
      setResult(data);setMode("speaking");
      // §71 — No seal suffix for greetings (nothing to seal)
      const isGreeting=data.decision&&data.decision.type==="greeting";
      const vt=(data.maria_voice&&(data.maria_voice[lang]||data.maria_voice.PT)||"")+(isGreeting?"":(" "+t.suffix));
      speakMaria(vt,lang,()=>setMode("result"));
    },wait);
    timers.current.push(t1);
  },[lang,t]);

  const handleDemo=sc=>{if(mode==="processing")return;runPipeline(sc.intent,sc.input,sc);};
  // §79 — Demo Super Carta (map test)
  const handleDemoMap=async()=>{
    if(mode==="processing")return;
    setMode("processing");setTranscript("🗺️ Demo Super Carta");setDoneSt([]);setSealed(false);setShowIntent(false);setResult(null);
    const ids=STAGES.map(s=>s.id);
    ids.forEach((id,i)=>{
      const t0=setTimeout(()=>{setActiveStage(id);setDoneSt(prev=>[...prev,ids[i-1]].filter(Boolean));},i*200);
      timers.current.push(t0);
    });
    try{
      const r=await fetch("/travel/maria/demo-carta",{signal:AbortSignal.timeout(5000)});
      const data=await r.json();
      setApiSource("live");
      const t1=setTimeout(()=>{setDoneSt(ids.slice(0,-1));setActiveStage(null);setResult(data);setMode("result");},ids.length*200+100);
      timers.current.push(t1);
    }catch(e){setMode("idle");setApiSource(null);}
  };
  const handleVoice=tr=>{
    const sc=t.scenarios.find(s=>
      s.intent.type===(/museu|museum/i.test(tr)?"museum":/caf[eé]/i.test(tr)?"cafe":"restaurant")
    )||t.scenarios[0];
    runPipeline({...sc.intent},tr,sc);
  };
  // §69c — Smart intent detection from text input
  const detectIntentFromText=(text)=>{
    const lower=text.toLowerCase();
    // Greetings first (highest priority)
    if(/^(ol[aá]|oi|hey|hello|hallo|hi|bom dia|boa tarde|boa noite|guten|good morning|good evening)\b/i.test(lower))
      return {type:"greeting"};
    // Place types
    if(/farm[aá]cia|apotheke|pharmacy|medicamento/i.test(lower))return{type:"pharmacy"};
    if(/hospital|cl[ií]nica|urg[eê]ncia|krankenhaus|emergency/i.test(lower))return{type:"hospital"};
    if(/banco|bank|atm|multibanco|geldautomat/i.test(lower))return{type:"bank"};
    if(/supermercado|supermarkt|grocery|mercado/i.test(lower))return{type:"supermarket"};
    if(/caf[eé]|coffee|kaffee/i.test(lower))return{type:"cafe"};
    if(/restaurante?|comer|essen|jantar|almo[çc]o/i.test(lower))return{type:"restaurant"};
    if(/museu|museum/i.test(lower))return{type:"museum"};
    if(/praia|strand|beach/i.test(lower))return{type:"beach"};
    if(/hotel|alojamento|unterkunft|hostel/i.test(lower))return{type:"hotel"};
    if(/voo|voar|fly|flight|flug/i.test(lower))return{type:"flight"};
    // Default: general query
    return{type:"general"};
  };
  const handleText=()=>{
    if(!textIn.trim())return;
    const intent=detectIntentFromText(textIn);
    const sc=t.scenarios[0]; // fallback for UI demo data
    runPipeline(intent,textIn,sc);
    setTextIn("");
  };
  const reset=()=>{
    clearT();window.speechSynthesis&&window.speechSynthesis.cancel();
    setMode("idle");setResult(null);setActiveStage(null);
    setDoneSt([]);setSealed(false);setTranscript("");setApiSource(null);
  };

  const statusBg={idle:"rgba(255,255,255,0.1)",listening:P.vermelho,
    processing:P.ouro,speaking:P.agua,result:P.verde};
  const statusTxt={idle:t.s_idle,listening:t.s_listen,
    processing:t.s_proc,speaking:t.s_speak,result:t.s_result};
  const decision=result&&result.decision;
  const ctx=result&&result.context;

  return(
    <div style={{minHeight:"100vh",background:`linear-gradient(160deg,${P.branco},${P.pergaminho})`,fontFamily:"'Bricolage Grotesque',Georgia,sans-serif",paddingBottom:40}}>

      {/* HEADER */}
      <div style={{background:P.noite,padding:"13px 16px",display:"flex",alignItems:"center",justifyContent:"space-between",position:"sticky",top:0,zIndex:100}}>
