            <div style={{textAlign:"center",padding:"18px 0 14px"}}>
              <div style={{fontSize:10,color:P.cinza,fontFamily:"'JetBrains Mono',monospace",
                letterSpacing:"1px",marginBottom:6,textTransform:"uppercase"}}>{t.tagline}</div>
              <div style={{fontSize:19,fontWeight:900,color:P.noite,lineHeight:1.2,
                maxWidth:270,margin:"0 auto 18px"}}>{t.headline}</div>
              <MicButton onResult={handleVoice} onListening={()=>setMode("listening")} lang={lang} disabled={false}/>
              <div style={{fontSize:11,color:P.cinza,marginTop:9,fontFamily:"'JetBrains Mono',monospace"}}>{t.tap_mic}</div>
            </div>
            <div style={{display:"flex",alignItems:"center",gap:10,margin:"14px 0"}}>
              <div style={{flex:1,height:1,background:"rgba(139,94,60,0.15)"}}/>
              <span style={{fontSize:10,color:P.cinza,fontFamily:"'JetBrains Mono',monospace"}}>ou</span>
              <div style={{flex:1,height:1,background:"rgba(139,94,60,0.15)"}}/>
            </div>
            <div style={{marginBottom:14}}>
              <div style={{fontSize:10,fontFamily:"'JetBrains Mono',monospace",color:P.cinza,marginBottom:8,letterSpacing:"0.5px"}}>{t.demos_label}</div>
