                    <div style={{fontSize:17,fontWeight:800,color:P.noite}}>{decision.name}</div>
                    <div style={{fontSize:12,color:P.cinza,marginTop:2}}>{decision.type} · {decision.distance_text}</div>
                    {decision.rating&&<div style={{fontSize:11,color:P.ouro,marginTop:2}}>★ {decision.rating}</div>}
                  </div>
                  <div style={{background:P.verde,color:"white",borderRadius:20,padding:"3px 9px",fontSize:10,fontWeight:600,fontFamily:"'JetBrains Mono',monospace"}}>{decision.queue_status}</div>
                </div>
                <div style={{background:"rgba(26,26,46,0.04)",borderRadius:8,padding:"9px 11px",marginBottom:11,borderLeft:`3px solid ${P.ouro}`}}>
                  <div style={{fontSize:10,fontFamily:"'JetBrains Mono',monospace",color:P.cinza,marginBottom:3,letterSpacing:"0.5px"}}>{t.reason_label}</div>
                  <div style={{fontSize:12,color:P.terra,lineHeight:1.5}}>{decision.reason}</div>
                </div>
                {!sealed?(
                  <button onClick={()=>setSealed(true)} style={{width:"100%",padding:"11px",
                    background:`linear-gradient(135deg,${P.terra},${P.ouro})`,color:"white",
                    border:"none",borderRadius:10,fontSize:13,fontWeight:700,cursor:"pointer"}}>{t.seal_btn}</button>
                ):(
                  <div style={{background:P.verde,color:"white",borderRadius:10,padding:"9px",
                    textAlign:"center",fontSize:11,fontFamily:"'JetBrains Mono',monospace"}}>
                    ✓ SEALED · {result.ledger_receipt_id||"WINDI-TRAVEL-"+Date.now().toString(36).toUpperCase()}
                  </div>
                )}
              </div>
            </div>
            )}

            {/* §80 — 3 Layers Receipt Display (Human → Technical → API) */}
            {sealed&&decision.type!=="greeting"&&(
              <div style={{background:"rgba(92,122,90,0.08)",border:`1px solid ${P.verde}44`,
                borderRadius:12,padding:"14px 16px",marginBottom:14,animation:"fadeIn 0.4s ease"}}>

                {/* LAYER 1 — HUMAN (sempre visível) */}
                <div style={{display:"flex",alignItems:"center",gap:8,marginBottom:12}}>
                  <div style={{width:36,height:36,background:P.verde,borderRadius:"50%",
                    display:"flex",alignItems:"center",justifyContent:"center",fontSize:18}}>✓</div>
                  <div>
                    <div style={{fontSize:14,fontWeight:800,color:P.verde}}>
                      {lang==="PT"?"SELADO":lang==="DE"?"VERSIEGELT":"SEALED"}
                    </div>
                    <div style={{fontSize:10,fontFamily:"'JetBrains Mono',monospace",color:P.cinza}}>
                      {result.ledger_receipt_id||"DEMO-"+Date.now().toString(36).toUpperCase()}
                    </div>
                  </div>
                </div>

                <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:8,marginBottom:12}}>
                  <div style={{display:"flex",alignItems:"center",gap:6}}>
                    <span style={{fontSize:14}}>📍</span>
                    <span style={{fontSize:12,color:P.noite}}>{decision.name}</span>
                  </div>
                  <div style={{display:"flex",alignItems:"center",gap:6}}>
                    <span style={{fontSize:14}}>🕐</span>
                    <span style={{fontSize:11,color:P.cinza}}>
                      {new Date(result.timestamp).toLocaleString(lang==="PT"?"pt-PT":lang==="DE"?"de-DE":"en-GB",{day:"numeric",month:"short",hour:"2-digit",minute:"2-digit"})}
                    </span>
                  </div>
                </div>

                <div style={{display:"flex",alignItems:"center",gap:6,padding:"8px 10px",
                  background:"rgba(92,122,90,0.1)",borderRadius:8}}>
                  <span style={{fontSize:14}}>🔐</span>
                  <span style={{fontSize:11,color:P.verde}}>
                    {lang==="PT"?"Decisão verificável no Ledger":lang==="DE"?"Im Ledger verifizierbar":"Verifiable on Ledger"}
                  </span>
                </div>

                {/* LAYER 2 — TECHNICAL (collapsed) */}
                <details style={{marginTop:10}}>
                  <summary style={{fontSize:10,fontFamily:"'JetBrains Mono',monospace",color:P.cinza,
                    cursor:"pointer",letterSpacing:"0.5px",padding:"4px 0"}}>
                    {lang==="PT"?"▶ Ver detalhes técnicos":lang==="DE"?"▶ Technische Details":"▶ View technical details"}
                  </summary>
                  <div style={{marginTop:8,padding:"10px",background:"rgba(26,26,46,0.04)",borderRadius:8}}>
                    <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:6,fontSize:10,fontFamily:"'JetBrains Mono',monospace"}}>
                      <div><span style={{color:P.cinza}}>source:</span> <span style={{color:P.terra}}>{apiSource}</span></div>
                      <div><span style={{color:P.cinza}}>governance:</span> <span style={{color:P.ouro}}>HIGH</span></div>
                      <div><span style={{color:P.cinza}}>lang:</span> <span style={{color:P.terra}}>{lang}</span></div>
                      <div><span style={{color:P.cinza}}>verified:</span> <span style={{color:P.verde}}>true</span></div>
                    </div>
                  </div>
                </details>
              </div>
            )}

            {/* §79 — Super Carta: Shows map when locations are available */}
            {result.locations&&result.locations.length>0&&(
              <SuperCarta
                locations={result.locations}
                userLat={userGPS.lat}
                userLng={userGPS.lng}
                lang={lang}
              />
            )}

            <button onClick={reset} style={{width:"100%",padding:"11px",background:"transparent",
              border:`1px solid rgba(139,94,60,0.3)`,borderRadius:10,color:P.terra,fontSize:13,cursor:"pointer"}}>{t.new_btn}</button>
          </div>
        )}

        <div style={{textAlign:"center",marginTop:22,fontSize:10,
          fontFamily:"'JetBrains Mono',monospace",color:P.cinza,letterSpacing:"0.5px"}}>
          AI processes. Human decides. WINDI guarantees. 🐉
        </div>
      </div>
    </div>
  );
}

ReactDOM.createRoot(document.getElementById('root')).render(<App/>);
</script>
</body>
</html>
