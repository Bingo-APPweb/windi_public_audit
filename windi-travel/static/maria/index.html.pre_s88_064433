async function callMariaAPI(intent,lang,fallbackSc,inputText=""){
  const{lat,lng}=await getGPS();
  try{
    const ctrl=new AbortController();
    const tid=setTimeout(()=>ctrl.abort(),API_TIMEOUT);
    const r=await fetch(MARIA_API,{
      method:"POST",headers:{"Content-Type":"application/json"},
      body:JSON.stringify({intent,lang,lat,lng,wallet_id:WALLET_ID,query:inputText}),signal:ctrl.signal,
    });
    clearTimeout(tid);
    if(!r.ok)throw new Error(`HTTP ${r.status}`);
    return{source:"live",data:await r.json()};
  }catch(e){
    return{source:"fallback",data:{
      request_id:"demo-"+Math.random().toString(36).slice(2,10),
      decision:fallbackSc.s,context:fallbackSc.ctx,
      maria_voice:{PT:fallbackSc.voice,DE:fallbackSc.voice,EN:fallbackSc.voice},
      intent_parsed:intent,ledger_receipt_id:null,sovereign_mode:true,
      timestamp:new Date().toISOString(),
