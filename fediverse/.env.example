# W-FEDIVERSE-001 — Glass Embassy Configuration
# Copy to .env and fill in your credentials

# ═══════════════════════════════════════════════════════════════
# MASTODON (ActivityPub)
# ═══════════════════════════════════════════════════════════════
# Instance URL (default: mastodon.social)
MASTODON_INSTANCE=https://mastodon.social

# Access Token (get from: Settings → Development → New Application)
# Required scopes: read, write:statuses, write:media
MASTODON_ACCESS_TOKEN=

# ═══════════════════════════════════════════════════════════════
# BLUESKY (AT Protocol)
# ═══════════════════════════════════════════════════════════════
# Service URL (default: bsky.social)
BLUESKY_SERVICE=https://bsky.social

# Handle (without @, e.g., windi.bsky.social)
BLUESKY_HANDLE=

# App Password (get from: Settings → App Passwords → Add App Password)
# DO NOT use your main password!
BLUESKY_APP_PASSWORD=
