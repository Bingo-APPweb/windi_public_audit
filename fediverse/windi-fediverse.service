[Unit]
Description=W-FEDIVERSE-001 — Glass Embassy · Multi-Protocol Truth Distribution
After=network.target windi-vd-cut.service
Wants=windi-vd-cut.service

[Service]
Type=simple
User=windi
Group=windi
WorkingDirectory=/opt/windi/fediverse
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/opt/windi"
ExecStart=/usr/bin/python3 fediverse_server.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
