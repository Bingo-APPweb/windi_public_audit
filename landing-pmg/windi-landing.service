[Unit]
Description=WINDI Landing Page P/M/G v1.0.0
Documentation=https://windi-domain.com/health
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=windi
Group=windi
WorkingDirectory=/opt/windi/landing-pmg
Environment=LANDING_PORT=8107
ExecStart=/usr/bin/python3 /opt/windi/landing-pmg/landing_server.py
Restart=always
RestartSec=5
StandardOutput=append:/opt/windi/logs/landing_pmg.log
StandardError=append:/opt/windi/logs/landing_pmg.log

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/windi/logs /opt/windi/landing-pmg

[Install]
WantedBy=multi-user.target
