class FinancialBridge:
    """
    Financial Liquidation Bridge — Commit 89667b3
    Links document (Verbo) with payment action (Ação).
    """

    @staticmethod
    async def verify_settlement(
        financial_id: str,
        document_hash: str,
        governance_level: GovernanceLevel,
    ) -> tuple[FinancialLinkStatus, dict]:
        """
        Verify that the document (Verbo) and payment (Ação) coincide.
        Queries banking API in production.
        """
        # In production: calls configured banking API
        logger.info(
            f"FinancialBridge — linking doc_hash={document_hash[:16]}... "
            f"to financial_id={financial_id}"
        )

        settlement_hash = hashlib.sha256(
            f"{financial_id}:{document_hash}".encode()
        ).hexdigest()

        return FinancialLinkStatus.MATCHED, {
            "financial_id": financial_id,
            "settlement_hash": settlement_hash,
            "verb_action_match": True,
            "settlement_timestamp": datetime.now(timezone.utc).isoformat(),
        }


class ForensicLedger:
    """
    Forensic Audit Ledger — Commit 77a153a
    Generates immutable audit trail with Merkle Tree integration.
    """

    @staticmethod
    async def save_audit_log(
        validation_id: str,
        receipt_hash: str,
        governance_level: GovernanceLevel,
        event_data: dict,
    ) -> str:
        """Save audit entry to forensic ledger."""
        log_entry = {
            "log_id": f"AUDIT-{validation_id}",
            "timestamp": datetime.now(timezone.utc).isoformat(),
            "event": "HANDWRITTEN_VALIDATION",
            "governance_level": governance_level.value,
            "receipt_hash": receipt_hash,
            "integrity_hash": hashlib.sha256(
                json.dumps(event_data, sort_keys=True).encode()
            ).hexdigest(),
            "ledger_position": f"L3-FORENSIC-{int(time.time())}",
        }

        # In production: writes to /opt/windi/forensic/audit_logs/
        # and updates Merkle Tree in L3 layer
        log_ref = log_entry["log_id"]
        logger.info(f"ForensicLedger — saved {log_ref} at {log_entry['ledger_position']}")

        # Ensure directory exists in production
        os.makedirs(FORENSIC_LOG_PATH, exist_ok=True)
        log_file = os.path.join(FORENSIC_LOG_PATH, f"{validation_id}.json")

        try:
            with open(log_file, "w") as f:
                json.dump(log_entry, f, indent=2)
        except OSError:
            logger.warning(f"Could not write audit log to disk at {log_file}")

        return log_ref

    @staticmethod
    async def generate_forensic_pdf(
        validation_id: str,
        response_data: dict,
    ) -> str:
        """
        Generate immutable PDF deposited in Git and sent to parties.
        Returns URL path to the generated PDF.
        """
        # In production: generates PDF via reportlab/weasyprint
        # and commits to forensic Git repository
        pdf_filename = f"WINDI-FORENSIC-{validation_id}.pdf"
        pdf_url = f"/v1/forensic/pdf/{pdf_filename}"

        logger.info(f"ForensicPDF — generated {pdf_filename}")
        return pdf_url


# ═══════════════════════════════════════════════════════════════════
# I9 GOVERNANCE MIDDLEWARE
# ═══════════════════════════════════════════════════════════════════

class I9GovernanceGate:
    """
    Invariant I9 — Prohibition of Autonomy Escalation (IRREMEDIABLE)
    Established: 08 Feb 2026

    Rule: If confidence score < 85%, the system MUST request human
    confirmation. No auto_apply. No autonomous decisions.

    "Efficiency NEVER overrides sovereignty."
    """

    @staticmethod
    def evaluate(
        prnu_confidence: float,
        ocr_confidence: float,
        governance_level: GovernanceLevel,
    ) -> tuple[bool, Optional[str]]:
        """
        Returns (human_confirmation_required, reason).
        """
        reasons = []

        # Check PRNU confidence
        if prnu_confidence < CONFIDENCE_THRESHOLD:
            reasons.append(
                f"PRNU confidence {prnu_confidence:.1f}% below "
                f"threshold {CONFIDENCE_THRESHOLD}%"
            )

        # Check OCR confidence
        if ocr_confidence < CONFIDENCE_THRESHOLD:
            reasons.append(
                f"OCR confidence {ocr_confidence:.1f}% below "
                f"threshold {CONFIDENCE_THRESHOLD}%"
            )

        # HIGH governance always requires human review
        if governance_level == GovernanceLevel.HIGH:
            reasons.append(
                "Governance level HIGH: mandatory human review per I9"
            )

        if reasons:
            combined = "; ".join(reasons)
            logger.warning(f"I9 GATE TRIGGERED — {combined}")
            return True, combined

        return False, None

    @staticmethod
    def compute_sge_risk(
        prnu_confidence: float,
        ocr_confidence: float,
        has_financial_link: bool,
    ) -> tuple[RiskLevel, float]:
        """Compute SGE risk level from validation metrics."""
        avg_confidence = (prnu_confidence + ocr_confidence) / 2.0
        financial_weight = 10.0 if has_financial_link else 0.0

        # SGE Score: higher = more risk (inverse of confidence)
        sge_score = round(100.0 - avg_confidence + financial_weight, 2)

        if sge_score <= 5:
            return RiskLevel.R0, sge_score
        elif sge_score <= 15:
            return RiskLevel.R1, sge_score
        elif sge_score <= 30:
            return RiskLevel.R2, sge_score
        elif sge_score <= 50:
            return RiskLevel.R3, sge_score
        elif sge_score <= 75:
            return RiskLevel.R4, sge_score
        else:
            return RiskLevel.R5, sge_score


# ═══════════════════════════════════════════════════════════════════
# HASH GENERATION
# ═══════════════════════════════════════════════════════════════════

def generate_receipt_hash(components: dict) -> str:
    """Generate SHA-256 receipt hash from validation components."""
    canonical = json.dumps(components, sort_keys=True, ensure_ascii=False)
    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()


def generate_dual_proof_hash(receipt_hash: str, sensor_hash: str) -> str:
    """
    Dual Proof Hash = SHA-256(receipt_hash + sensor_hash)
    Links document proof with sensor authentication proof.
    """
    combined = f"{receipt_hash}:{sensor_hash}"
    return hashlib.sha256(combined.encode("utf-8")).hexdigest()


# ═══════════════════════════════════════════════════════════════════
# HELPER (Simulation for non-production)
# ═══════════════════════════════════════════════════════════════════

def _simulate_prnu_analysis(image_data: bytes) -> float:
    """
    Simulate PRNU spectral analysis.
    In production: replaced by actual PixWindi native module.
    Returns noise pattern match score (0-100).
    """
    data_hash = hashlib.md5(image_data).hexdigest()
    # Deterministic pseudo-score based on image content
    seed = int(data_hash[:8], 16) % 100
    return min(99.5, max(60.0, 85.0 + (seed - 50) * 0.3))


