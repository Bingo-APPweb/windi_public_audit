async def health_check():
    return {
        "status": "operational",
        "service": "WINDI Forensic — Digital Notary",
        "version": "1.0.0",
        "invariants": "I1-I9 ACTIVE",
        "i9_status": "IRREMEDIABLE — Autonomy Escalation Prohibited",
        "three_dragons": "Guardian(Claude) + Architect(GPT) + Witness(Gemini)",
        "timestamp": datetime.now(timezone.utc).isoformat(),
    }


# ─── Main Endpoint ───────────────────────────────────────────────

@app.post(
    "/v1/forensic/validate-handwritten",
    response_model=ForensicValidationResponse,
    status_code=status.HTTP_200_OK,
    summary="Validate handwritten document — Digital Notary",
    description=(
        "Receives raw handwritten artifact, authenticates via PixWindi "
        "anti-deepfake engine, extracts semantic content, optionally links "
        "to financial settlement, and produces immutable Virtue Receipt."
    ),
)
async def validate_handwritten(
    image_file: UploadFile = File(
        ..., description="Binary image file of handwritten document"
    ),
    metadata_json: str = Form(
        ..., description="JSON string with GPS, Timestamp Mobile, Device ID"
    ),
    link_financial_id: Optional[str] = Form(
        None, description="Optional financial transaction ID for settlement"
    ),
    x_windi_identity: str = Header(
        ..., alias="X-WINDI-Identity",
        description="Authenticated WINDI user identity"
    ),
    x_governance_level: GovernanceLevel = Header(
        GovernanceLevel.MEDIUM,
        alias="X-Governance-Level",
        description="Governance rigor level: BASIC, MEDIUM, HIGH"
    ),
):
    """
    ╔═══════════════════════════════════════════════════════════╗
    ║  POST /v1/forensic/validate-handwritten                  ║
    ║  The Digital Notary — "Compromisso Autenticado"          ║
    ╚═══════════════════════════════════════════════════════════╝

    Orchestration Flow:
    1. Ingestion — Validate identity & parse metadata
    2. Acreditação (68ca874) — PixWindi PRNU + anti-deepfake
    3. Análise Semiótica — Calligraphy → vectors → a4Desk format
    4. Liquidação (89667b3) — Optional financial settlement link
    5. Resposta — dual_proof_hash + Forensic PDF URL
    """
    validation_id = f"VAL-{uuid.uuid4().hex[:12].upper()}"
    timestamp_utc = datetime.now(timezone.utc).isoformat()

    logger.info(
        f"═══ VALIDATION START {validation_id} ═══ "
        f"identity={x_windi_identity} governance={x_governance_level.value}"
    )

    # ┌─────────────────────────────────────────────────────────┐
    # │ STEP 1: INGESTION — Validate headers & parse metadata   │
    # └─────────────────────────────────────────────────────────┘

    # Validate identity header
    if not x_windi_identity or len(x_windi_identity) < 3:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail={
                "error": "IDENTITY_INVALID",
                "message": "X-WINDI-Identity header is missing or invalid",
                "i9_note": "Identity verification is a governance prerequisite",
            },
        )

    # Parse metadata
    try:
        metadata = MetadataInput(**json.loads(metadata_json))
    except (json.JSONDecodeError, Exception) as e:
        raise HTTPException(
            status_code=status.HTTP_422_UNPROCESSABLE_ENTITY,
            detail={
                "error": "METADATA_INVALID",
                "message": f"Invalid metadata_json: {str(e)}",
            },
        )

    # Read image data
    image_data = await image_file.read()
    if len(image_data) == 0:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail={"error": "IMAGE_EMPTY", "message": "Uploaded image is empty"},
        )

    logger.info(
        f"[{validation_id}] Ingestion OK — "
        f"image_size={len(image_data)} bytes, device={metadata.device_id}"
    )

    # ┌─────────────────────────────────────────────────────────┐
    # │ STEP 2: ACREDITAÇÃO — PixWindi PRNU (Commit 68ca874)   │
    # └─────────────────────────────────────────────────────────┘

    prnu_result = await PixWindiEngine.process_handwritten_document(
        image_data=image_data,
        device_id=metadata.device_id,
        governance_level=x_governance_level,
    )

    # Determine anti-deepfake status
    if prnu_result.is_authentic:
        anti_deepfake_status = AntiDeepfakeStatus.AUTHENTIC
    elif prnu_result.deepfake_probability > 50:
        anti_deepfake_status = AntiDeepfakeStatus.REJECTED
    elif prnu_result.noise_pattern_match < CONFIDENCE_THRESHOLD:
        anti_deepfake_status = AntiDeepfakeStatus.PENDING_HUMAN_REVIEW
    else:
        anti_deepfake_status = AntiDeepfakeStatus.SUSPICIOUS

    logger.info(
        f"[{validation_id}] Acreditação — status={anti_deepfake_status.value}"
    )

    # ┌─────────────────────────────────────────────────────────┐
    # │ STEP 3: ANÁLISE SEMIÓTICA — Calligraphy → a4Desk       │
    # └─────────────────────────────────────────────────────────┘

    semantic_result = await SemanticAnalyzer.analyze(
        image_data=image_data,
        governance_level=x_governance_level,
    )

    logger.info(
        f"[{validation_id}] Semiótica — "
        f"OCR_conf={semantic_result.confidence_ocr}% "
        f"lang={semantic_result.language_detected}"
    )

    # ┌─────────────────────────────────────────────────────────┐
    # │ I9 GOVERNANCE GATE — Autonomy Escalation Check         │
    # └─────────────────────────────────────────────────────────┘

    human_required, human_reason = I9GovernanceGate.evaluate(
        prnu_confidence=prnu_result.noise_pattern_match,
        ocr_confidence=semantic_result.confidence_ocr,
        governance_level=x_governance_level,
    )

    sge_risk, sge_score = I9GovernanceGate.compute_sge_risk(
        prnu_confidence=prnu_result.noise_pattern_match,
        ocr_confidence=semantic_result.confidence_ocr,
        has_financial_link=link_financial_id is not None,
    )

    i9_status = "COMPLIANT" if not human_required else "GATE_TRIGGERED"

    if human_required:
        logger.warning(
            f"[{validation_id}] ⚠️ I9 GATE — Human confirmation required: "
            f"{human_reason}"
        )

    # ┌─────────────────────────────────────────────────────────┐
    # │ STEP 4: LIQUIDAÇÃO — Financial Link (Commit 89667b3)   │
    # └─────────────────────────────────────────────────────────┘

    financial_status = FinancialLinkStatus.NOT_REQUESTED
    financial_details = None

    if link_financial_id:
        doc_hash = hashlib.sha256(image_data).hexdigest()
        financial_status, financial_details = (
            await FinancialBridge.verify_settlement(
                financial_id=link_financial_id,
                document_hash=doc_hash,
                governance_level=x_governance_level,
            )
        )
        logger.info(
            f"[{validation_id}] Liquidação — "
            f"status={financial_status.value} "
            f"financial_id={link_financial_id}"
        )

    # ┌─────────────────────────────────────────────────────────┐
    # │ STEP 5: RESPOSTA — Hashes, Receipt, PDF                │
    # └─────────────────────────────────────────────────────────┘

    # Generate receipt hash
    receipt_components = {
        "validation_id": validation_id,
        "timestamp": timestamp_utc,
        "identity": x_windi_identity,
        "governance_level": x_governance_level.value,
        "prnu_sensor_hash": prnu_result.sensor_hash,
        "anti_deepfake": anti_deepfake_status.value,
        "ocr_confidence": semantic_result.confidence_ocr,
        "sge_risk": sge_risk.value,
        "sge_score": sge_score,
        "financial_link": financial_status.value,
        "device_id": metadata.device_id,
        "device_timestamp": metadata.timestamp_mobile,
    }
    receipt_hash = generate_receipt_hash(receipt_components)

    # Generate dual proof hash
    dual_proof_hash = generate_dual_proof_hash(
        receipt_hash=receipt_hash,
        sensor_hash=prnu_result.sensor_hash,
    )

    # Build Virtue Receipt (Zero-Knowledge: no sensitive data)
    virtue_receipt = VirtueReceipt(
        receipt_id=f"VR-{validation_id}",
        receipt_hash=receipt_hash,
        categories={
            "type": "HANDWRITTEN_VALIDATION",
            "impact": x_governance_level.value,
            "domain": "FORENSIC",
            "value_range": sge_risk.value,
        },
        governance={
            "sge_score": sge_score,
            "risk": sge_risk.value,
            "validation": anti_deepfake_status.value,
            "i9_compliant": i9_status == "COMPLIANT",
        },
        decision={
            "action": "VALIDATE_HANDWRITTEN",
            "role": x_windi_identity,
            "timestamp": timestamp_utc,
            "ai_recommendation": anti_deepfake_status.value,
            "override": None,
            "human_confirmed": not human_required,
        },
        flags=[
            f"I9:{i9_status}",
            f"SGE:{sge_risk.value}",
            f"PRNU:{anti_deepfake_status.value}",
        ]
        + (["FINANCIAL_LINKED"] if link_financial_id else [])
        + (["HUMAN_REVIEW_REQUIRED"] if human_required else []),
    )

    # Save audit log (Commit 77a153a)
    audit_ref = await ForensicLedger.save_audit_log(
        validation_id=validation_id,
        receipt_hash=receipt_hash,
        governance_level=x_governance_level,
        event_data=receipt_components,
    )

    # Generate forensic PDF
    forensic_pdf_url = await ForensicLedger.generate_forensic_pdf(
        validation_id=validation_id,
        response_data=receipt_components,
    )

    logger.info(
        f"═══ VALIDATION COMPLETE {validation_id} ═══ "
        f"receipt_hash={receipt_hash[:16]}... "
        f"dual_proof={dual_proof_hash[:16]}... "
        f"risk={sge_risk.value} i9={i9_status}"
    )

    # ┌─────────────────────────────────────────────────────────┐
    # │ RETURN — The Digital Notary speaks                      │
    # └─────────────────────────────────────────────────────────┘

    return ForensicValidationResponse(
        validation_id=validation_id,
        timestamp_utc=timestamp_utc,
        governance_level=x_governance_level,
        anti_deepfake_validation=anti_deepfake_status,
        prnu_result=prnu_result,
        semantic_extraction=semantic_result,
        financial_link=financial_status,
        financial_details=financial_details,
        receipt_hash=receipt_hash,
        dual_proof_hash=dual_proof_hash,
        forensic_pdf_url=forensic_pdf_url,
        virtue_receipt=virtue_receipt,
        i9_status=i9_status,
        human_confirmation_required=human_required,
        human_confirmation_reason=human_reason,
        sge_risk_level=sge_risk,
        sge_score=sge_score,
        audit_log_ref=audit_ref,
    )


