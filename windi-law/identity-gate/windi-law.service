[Unit]
Description=WINDI LAW Identity Gate v1.0.0
After=network.target

[Service]
User=windi
WorkingDirectory=/opt/windi/windi-law/identity-gate
ExecStart=/usr/bin/python3 -m uvicorn identity_gate:app --host 127.0.0.1 --port 8122
Restart=always
RestartSec=5
StandardOutput=append:/opt/windi/logs/windi-law.log
StandardError=append:/opt/windi/logs/windi-law-error.log

[Install]
WantedBy=multi-user.target
