# W-SEC-001 Security Sentinel — Environment Configuration
# Copy to .env and fill in your values

# ═══════════════════════════════════════════════════════════════
# TELEGRAM WEBHOOKS
# ═══════════════════════════════════════════════════════════════

# Enable/disable Telegram notifications (default: true)
SEC_TELEGRAM_ENABLED=true

# Telegram Bot Token from @BotFather
# Format: 1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
SEC_TELEGRAM_BOT_TOKEN=

# Telegram Chat ID (group or channel)
# Groups have negative IDs: -1001234567890
# Use /getUpdates to find your chat_id
SEC_TELEGRAM_CHAT_ID=

# ═══════════════════════════════════════════════════════════════
# CORRELATION SETTINGS (optional)
# ═══════════════════════════════════════════════════════════════

# Correlation window in seconds (default: 300 = 5 minutes)
# SEC_CORRELATION_WINDOW=300

# Event threshold for merge (default: 5)
# SEC_MERGE_THRESHOLD=5

# Event threshold for escalation to HIGH (default: 25)
# SEC_ESCALATION_THRESHOLD=25

# Event threshold for CRITICAL (default: 100)
# SEC_CRITICAL_THRESHOLD=100
