/**
 * WINDI D1 Document Store — Zustand
 * Manages document state, autosave, and governance bridge (B1)
 */
import { create } from 'zustand';
import { get as idbGet, set as idbSet, del as idbDel, keys as idbKeys } from 'idb-keyval';
import { hashDocument, uuidv7, createVirtueReceipt, GOV_EVENTS } from '../utils/governance';

const AUTOSAVE_DEBOUNCE = 600; // ms
const LEDGER_URL = '/desktop/api/ledger'; // proxied to backend :8100 → :8101

/**
 * Send a governance event to the Forensic Ledger via B1 bridge
 */
