# W-MAIL-DACP-MILTER v1.0 Configuration
# Spec: §227
# Copy to .env and adjust values as needed

# Domain for email
DOMAIN=windisites.de

# Forensic Ledger URL
LEDGER_URL=http://172.17.0.1:8101
LEDGER_TIMEOUT=10

# Rate limiting (emails per minute per sender)
RATE_LIMIT_PER_MIN=100

# Logging
LOG_PATH=/logs/dacp-milter.log
LOG_LEVEL=INFO

# Milter socket (format: inet:port@host or unix:/path/to/socket)
MILTER_SOCKET=inet:8890@0.0.0.0

# HTTP admin port
HTTP_ADMIN_PORT=8895

# DKIM keys path (mounted from docker-mailserver)
DKIM_KEYS_PATH=/dkim/keys

# Git commit (set during build)
GIT_COMMIT=unknown
