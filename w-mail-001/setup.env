# W-MAIL-001 — Environment Configuration
# This file is sourced by setup scripts, not used by docker-compose

# Domain Configuration
DOMAIN=windisites.de
HOSTNAME=mail.windisites.de

# First Mailbox
ADMIN_EMAIL=postmaster@windisites.de
ADMIN_PASSWORD_FILE=./config/.admin-password

# DKIM Configuration
DKIM_SELECTOR_ED25519=ed25519
DKIM_SELECTOR_RSA=rsa
DKIM_KEYSIZE_RSA=2048

# Paths
CERT_PATH=/etc/letsencrypt/live/mail.windisites.de
MAILSERVER_CONFIG=./config
DKIM_PATH=./config/opendkim/keys/${DOMAIN}

# Ports
SMTP_PORT=25
SUBMISSION_PORT=587
SUBMISSIONS_PORT=465
IMAPS_PORT=993
SNAPPYMAIL_PORT=8200

# Logging
LOG_FILE=/opt/windi/logs/w-mail-001.log
