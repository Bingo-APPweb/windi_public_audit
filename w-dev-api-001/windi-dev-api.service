[Unit]
Description=W-DEV-API-001 — WINDI Developer API v1.1.0
Documentation=https://windi-domain.com/dev-api/v1/docs
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=windi
Group=windi
WorkingDirectory=/opt/windi/w-dev-api-001
ExecStart=/usr/bin/python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8200
Restart=always
RestartSec=5
StandardOutput=append:/opt/windi/logs/dev-api.log
StandardError=append:/opt/windi/logs/dev-api.log

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/windi/data /opt/windi/logs /opt/windi/w-dev-api-001

[Install]
WantedBy=multi-user.target
