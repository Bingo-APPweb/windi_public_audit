[Unit]
Description=WINDI LLM Bridge — W-GATEWAY-001
After=network.target

[Service]
Type=simple
User=windi
WorkingDirectory=/opt/windi/windi-gateway
EnvironmentFile=/opt/windi/windi-gateway/.env
ExecStart=/opt/windi/windi-gateway/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8130
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
